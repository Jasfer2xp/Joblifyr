# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Supabase PostgreSQL — Project: https://zbyipjlwtlbbuqllxgxy.supabase.co
# Dashboard: Project Settings > Database > Connection string > URI
# Direct:  postgresql://postgres:[PASSWORD]@db.zbyipjlwtlbbuqllxgxy.supabase.co:5432/postgres
