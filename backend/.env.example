DATABASE_URL=
DATABASE_SSLMODE=require

# Public URLs (production example below)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Google OAuth (Google Cloud Console > Credentials)
GOOGLE_CLIENT_ID=903772358828-vobfmqtpqvudth2b5qh3mt2q70dehnp3.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback/

# CORS (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://joblifyr.vercel.app

# Email verification (optional for email/password signup)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USER=
SMTP_PASS=
